load("@rules_go//go:def.bzl", "go_binary", "go_library")

filegroup(
    name = "config",
    srcs = glob(["config/**"]),
)

go_library(
    name = "go_default_library",
    srcs = [
        "main.go",
        "with_bb_portal.go",
        "without_bb_portal.go",
    ],
    importpath = "github.com/buildbarn/bb-deployments/bare",
    visibility = ["//visibility:public"],
    deps = ["@rules_go//go/runfiles:go_default_library"],
)

go_binary(
    name = "bare",
    data = [
        ":config",
        "@com_github_buildbarn_bb_remote_execution//cmd/bb_runner",
        "@com_github_buildbarn_bb_remote_execution//cmd/bb_scheduler",
        "@com_github_buildbarn_bb_remote_execution//cmd/bb_worker",
        "@com_github_buildbarn_bb_storage//cmd/bb_storage",
    ] + select({
        "//conditions:default": ["@com_github_buildbarn_bb_portal//cmd/bb_portal"],
        # Too long paths when building node modules on Windows.
        "@rules_go//go/platform:windows": [],
        # No nodejs toolchain.
        "@rules_go//go/platform:freebsd": [],
        # No nodejs toolchain.
        "@rules_go//go/platform:linux_arm": [],
        # No nodejs toolchain.
        "@rules_go//go/platform:linux_386": [],
    }),
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)
